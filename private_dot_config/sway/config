seat seat0 xcursor_theme phinger-cursors-light 36

### Key Bindings
set $term flatpak run org.wezfurlong.wezterm
set $menu wofi --show drun

## Basics
# Lines starting with `#:` are picked up by ~/scripts/sway-shortcuts.sh as the
# description for the binding directly below them. Sway itself ignores them.
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
#: Application launcher
bindsym $mod+d exec $menu
bindsym $mod+Shift+f exec $browser
bindsym $mod+Shift+i exec ~/scripts/toggle-dark-mode.sh
#: Jump to the most recently urgent window
bindsym $mod+x [urgent=latest] focus
#: Lock the screen
bindsym $mod+Control+l exec $lockman
#: Re-place workspaces and re-fill tiling after a display change
bindsym $mod+Shift+c exec ~/.config/sway/scripts/on-output-change.sh --once
# Reload is deliberately the harder chord: it re-runs every exec_always, and
# reaching for it as a display fix is what produced the black screen.
bindsym $mod+Control+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

floating_modifier $mod normal
