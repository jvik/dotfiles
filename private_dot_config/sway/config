### Window Rules

## Floating Windows
for_window [window_type="dialog"] floating enable
for_window [app_id="wdisplays"] floating enable
for_window [app_id="blueman-manager"] floating enable, border pixel 1, sticky enable
for_window [app_id="copyq"] floating enable, sticky enable, resize set height 600px width 550px, move position cursor, move down 330
for_window [app_id="waybar-calendar"] floating enable, sticky enable, move position cursor, move down 30
for_window [class="Bitwarden"] floating enable
for_window [app_id="nmwui"] floating enable, move position center
for_window [app_id="Calculator|snap-store"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 60 ppt
for_window [app_id="com.saivert.pwvucontrol"] floating enable
for_window [app_id="snx-rs-gui"] floating enable
# This borked
# for_window [title="^(?=.*Extension:)(?=.*Mozilla Firefox).*"] floating enable
for_window [title="^(Picture-in-Picture)$"] floating enable, sticky enable
for_window [title="Copying *"] floating enable
for_window [title="Moving *"] floating enable
for_window [title="Rename *"] floating enable
for_window [title="Firefox — Sharing Indicator"] floating enable
for_window [title="Remmina Remote Desktop Client"] floating enable, resize set width 800px height 600px, move position center
for_window [title="\ -\ Sharing\ Indicator$"] floating enable, sticky enable
# Teams screen-share indicator: anchor bottom-right (404x167 window + 40px/30px margin)
for_window [title="Screen is being shared$"] floating enable, sticky enable, move position 100 ppt 100 ppt, move left 444 px, move up 197 px
for_window [app_id="it.mijorus.smile"] floating enable, sticky enable
# Scratchpad apps: move to scratchpad on creation (keybinding toggles show/hide)
# Note: Slack and Teams are NOT auto-sent to scratchpad so their tray icons keep working.
for_window [app_id="md.obsidian.Obsidian"] move scratchpad
# Slack huddle call window (incl. pre-join "Huddle Preview") — keep visible across workspaces.
# Title is set async after map (for_window title matching races) and Slack ignores our
# requested height, so sizing/positioning is done by the script once the window settles.
for_window [app_id="com.slack.Slack" title="Huddle"] floating enable, sticky enable
for_window [app_id="com.slack.Slack"] exec ~/.config/sway/scripts/float-slack-huddle.sh
# Sharing indicators: pop back out of scratchpad immediately
for_window [app_id="com.slack.Slack" title="Sharing Indicator"] scratchpad show
for_window [app_id="com.github.IsmaelMartinez.teams_for_linux" title="Screen is being shared"] scratchpad show
# Workaround for glitchy behaviour in sway
for_window [app_id="^firefox$" title="^Extension: \(Bitwarden Password Manager\) - Bitwarden — Mozilla Firefox$"] exec "sleep 0.1; swaymsg floating enable; swaymsg floating disable; swaymsg floating enable"

