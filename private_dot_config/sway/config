## Resize Mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

## Present Mode
set $present_mode "present (m:mirror, o:output, r:region, R:unset, s:scale, f:freeze, k:kill)"
mode $present_mode {
    bindsym m mode "default"; exec wl-present mirror
    bindsym o mode "default"; exec wl-present set-output
    bindsym r mode "default"; exec wl-present set-region
    bindsym Shift+r mode "default"; exec wl-present unset-region
    bindsym s mode "default"; exec wl-present set-scaling
    bindsym f mode "default"; exec wl-present toggle-freeze
    bindsym c mode "default"; exec wl-present custom
    #: Stop mirroring
    bindsym k mode "default"; exec killall wl-mirror
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+shift+p mode $present_mode
bindsym XF86Display mode $present_mode

## Media and System Keys
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioPlay exec ~/scripts/media-play-toggle-or-next.sh
bindsym --locked XF86AudioNext exec playerctl next

## Screenshots
set $printscreen_mode "printscreen (r:region, f:full, w:window)"
mode $printscreen_mode {
    bindsym r mode "default"; exec ~/scripts/satty-screenshot.sh region
    bindsym f mode "default"; exec ~/scripts/satty-screenshot.sh full
    bindsym w mode "default"; exec ~/scripts/satty-screenshot.sh window
    #: Cancel, unfreeze the screen
    bindsym Return mode "default"; exec killall wayfreeze
    #: Cancel, unfreeze the screen
    bindsym Escape mode "default"; exec killall wayfreeze
}
bindsym $mod+p exec ~/.cargo/bin/wayfreeze; mode $printscreen_mode
bindsym Print exec ~/.cargo/bin/wayfreeze; mode $printscreen_mode

