### Core Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $browser firefox

### Theme
include ~/.config/sway/colors/gruvbox

### Startup Commands
exec --no-startup-id dbus-update-activation-environment --all
# Propagate Wayland env vars to systemd user session so D-Bus activated apps (e.g. GNOME Snapshot) can open displays
exec_always --no-startup-id systemctl --user import-environment SWAYSOCK WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec --no-startup-id lxpolkit
exec flatpak run com.bitwarden.desktop
# start copyq
exec /usr/bin/copyq --start-server
# keep clipboard content alive after the copying app (e.g. Satty) exits
# (full path: ~/.cargo/bin isn't on PATH for sway when launched outside an interactive shell, e.g. after reboot)
exec $HOME/.cargo/bin/wl-clip-persist --clipboard regular >"$HOME/.cache/wl-clip-persist.log" 2>&1
exec_always pgrep -x solaar || solaar --battery-icons=symbolic --window=hide

exec_always {
    rm /run/user/1000/pipectl.1000.wl-present.pipe 
}

# A reload resets output config to what this file says, discarding kanshi's
# positions, so kanshi does have to re-apply afterwards. But restarting it
# inline -- as `exec_always systemctl --user restart kanshi.service` did -- puts
# a DRM modeset on a compositor that is still rebuilding, which is what turned
# mod+Shift+c into a black screen. The script defers and lock-guards it.
exec_always ~/.config/sway/scripts/reapply-kanshi.sh
exec_always pgrep -x swaync >/dev/null || swaync
# The output watcher runs as a systemd unit, not as
#   exec_always "pkill -f <name>; <name>"
# sway runs exec_always through `sh -c "<the whole string>"`, so that shell's
# own argv matches the pkill pattern and it SIGTERMs itself before reaching the
# `;`. The predecessor of this watcher was never running for exactly that reason.
exec_always systemctl --user restart sway-output-watch.service
# Load-bearing: --monitor does not emit the subscribe ack, so the watcher does
# not fire once at startup. This is the initial reconcile.
exec_always ~/.config/sway/scripts/on-output-change.sh --once
# exec_always "killall autotiling; $HOME/.local/bin/autotiling"

### Output Configuration
workspace 10 output eDP-1

### Idle Configuration
set $locker swaylock -f
set $lockman exec bash ~/.config/sway/lockman.sh

# Timeouts and the battery check live in idle.sh, which is PID-file scoped so a
# reload doesn't also kill the swayidle lockman.sh runs while the screen is locked.
exec_always ~/.config/sway/scripts/idle.sh

