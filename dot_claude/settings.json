{
  "theme": "auto",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git blame*)",
      "Bash(git stash list*)",

      "Bash(chezmoi diff*)",
      "Bash(chezmoi status*)",
      "Bash(chezmoi data*)",
      "Bash(chezmoi doctor*)",
      "Bash(chezmoi cat*)",
      "Bash(chezmoi managed*)",
      "Bash(chezmoi source-path*)",
      "Bash(chezmoi verify*)",
      "Bash(chezmoi apply --dry-run)",

      "Bash(ansible-lint*)",
      "Bash(ansible-playbook * --check)",
      "Bash(ansible-playbook * --syntax-check)",

      "Bash(shellcheck*)",
      "Bash(shfmt -d*)",
      "Bash(fish -n *)",
      "Bash(luacheck*)",

      "Bash(ls*)",
      "Bash(find*)",
      "Bash(rg*)",
      "Bash(grep*)",
      "Bash(wc*)",
      "Bash(file*)",
      "Bash(tree*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(pwd)",
      "Bash(which*)"
    ],
    "deny": [
      "Bash(find*-exec*)",
      "Bash(find*-execdir*)",
      "Bash(find*-delete*)",
      "Bash(find*-fprintf*)",
      "Bash(find*|*)",

      "Bash(*;*)",
      "Bash(*&&*)",
      "Bash(*||*)",
      "Bash(*`*)",
      "Bash(*$(*)*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh/id_ed25519", "mode": "deny" },
        { "path": "~/.ssh/id_rsa", "mode": "deny" },
        { "path": "~/.ssh/id_ecdsa", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.docker", "mode": "deny" },
        { "path": "~/.kube/config", "mode": "deny" },
        { "path": "~/.mozilla", "mode": "deny" },
        { "path": "~/.config/Bitwarden CLI", "mode": "deny" },
        { "path": "~/.var/app/com.bitwarden.desktop", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "BW_SESSION", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "api.github.com",
        "pypi.org",
        "api.anthropic.com",
        "archive.ubuntu.com",
        "crates.io",
        "files.pythonhosted.org",
        "github.com",
        "index.crates.io",
        "registry.yarnpkg.com",
        "yarnpkg.com",
        "security.ubuntu.com",
        "static.crates.io",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "formulae.brew.sh",
        "ghcr.io",
        "flathub.org",
        "packages.mozilla.org",
        "www.yr.no",
        "wttr.in",
        "wiki.archlinux.org",
        "swaywm.org",
        "mirrors.fedoraproject.org",
        "download.fedoraproject.org",
        "dl.fedoraproject.org",
        "packages.microsoft.com",
        "repo.jotta.cloud",
        "repository.mullvad.net"
      ],
      "httpProxyPort": 8080,
      "socksProxyPort": 8081
    }
  }
}